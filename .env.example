# ---------------------------------------------------------------------------
# SpotLens environment variables
# Copy to `.env` (Prisma reads .env; Next.js reads .env and .env.local).
# ---------------------------------------------------------------------------

# Postgres (Neon in staging/prod, docker-compose locally).
# The chart works without a database — the curated asset list is read from
# lib/market-data/curated-assets.ts and candles come straight from the provider.
# Accounts, watchlist, settings and analysis history need it.
#
# On Neon, copy BOTH connection strings from the Connect dialog:
#   DATABASE_URL — with "Connection pooling" ON  (the -pooler host)
#   DIRECT_URL   — with "Connection pooling" OFF (used only by migrations,
#                  because Prisma's advisory locks need a direct connection)
DATABASE_URL="postgresql://spotlens:spotlens@localhost:5432/spotlens?schema=public"
DIRECT_URL="postgresql://spotlens:spotlens@localhost:5432/spotlens?schema=public"

# Binance public REST base. No API key needed — public market data only.
# SpotLens never requests or stores trading-scoped keys.
BINANCE_API_BASE_URL="https://api.binance.com"
NEXT_PUBLIC_BINANCE_WS_BASE_URL="wss://stream.binance.com:9443"

# Auth.js. Generate a secret with:  openssl rand -base64 32
# AUTH_SECRET is the v5 name; NEXTAUTH_SECRET is still read for compatibility.
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# Optional OAuth. Not wired up: SpotLens uses email/password only, which is
# why Auth.js runs JWT sessions rather than database sessions (its Credentials
# provider does not support the database strategy).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Phase 8 — rate limiting / queue / billing / monitoring
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
CRON_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SENTRY_DSN=""
