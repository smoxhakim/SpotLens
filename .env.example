# ---------------------------------------------------------------------------
# SpotLens environment variables
# Copy to `.env` (Prisma reads .env; Next.js reads .env and .env.local).
# ---------------------------------------------------------------------------

# Postgres (Neon in staging/prod, docker-compose locally).
# Optional in Phase 1: without it the app serves the curated asset list from
# lib/market-data/curated-assets.ts and fetches candles straight from Binance.
DATABASE_URL="postgresql://spotlens:spotlens@localhost:5432/spotlens?schema=public"

# Binance public REST base. No API key needed — public market data only.
# SpotLens never requests or stores trading-scoped keys.
BINANCE_API_BASE_URL="https://api.binance.com"
NEXT_PUBLIC_BINANCE_WS_BASE_URL="wss://stream.binance.com:9443"

# App URL (used by NextAuth from Phase 4 on).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Phase 4+
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Phase 8 — rate limiting / queue / billing / monitoring
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
CRON_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SENTRY_DSN=""
