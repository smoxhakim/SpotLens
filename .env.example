# ---------------------------------------------------------------------------
# SpotLens environment variables
# Copy to `.env` (Prisma reads .env; Next.js reads .env and .env.local).
# ---------------------------------------------------------------------------

# Postgres (Neon in staging/prod, docker-compose locally).
# The chart works without a database — the curated asset list is read from
# lib/market-data/curated-assets.ts and candles come straight from the provider.
# Accounts, watchlist, settings and analysis history need it.
#
# On Neon, copy BOTH connection strings from the Connect dialog:
#   DATABASE_URL — with "Connection pooling" ON  (the -pooler host)
#   DIRECT_URL   — with "Connection pooling" OFF (used only by migrations,
#                  because Prisma's advisory locks need a direct connection)
DATABASE_URL="postgresql://spotlens:spotlens@localhost:5432/spotlens?schema=public"
DIRECT_URL="postgresql://spotlens:spotlens@localhost:5432/spotlens?schema=public"

# Binance public REST base. No API key needed — public market data only.
# SpotLens never requests or stores trading-scoped keys.
BINANCE_API_BASE_URL="https://api.binance.com"
NEXT_PUBLIC_BINANCE_WS_BASE_URL="wss://stream.binance.com:9443"

# Auth.js. Generate a secret with:  openssl rand -base64 32
# AUTH_SECRET is the v5 name; NEXTAUTH_SECRET is still read for compatibility.
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# Optional OAuth. Not wired up: SpotLens uses email/password only, which is
# why Auth.js runs JWT sessions rather than database sessions (its Credentials
# provider does not support the database strategy).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Rate limiting. Optional: without these, limits are enforced in-process,
# which is correct for a single instance and useless across several.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Not wired up. Billing, queued jobs and error tracking are deliberately out of
# scope for a single-user deployment; the variables are listed so the shape is
# documented if that ever changes.
QSTASH_TOKEN=""
CRON_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SENTRY_DSN=""

# ---------------------------------------------------------------------------
# Local scanner (`npm run scanner`)
# ---------------------------------------------------------------------------
# The scanner is a separate local process. It wakes shortly after each candle
# closes rather than polling, analyses the curated markets with the same engine
# the app uses, and updates the setups it is already tracking.
#
# All optional — the defaults below are what it uses if these are unset.

# Markets analysed at once. Ninety analyses fired together would be a burst of
# requests at a public endpoint; four keeps it to a trickle.
SCANNER_MAX_CONCURRENCY="4"

# Entry timeframes to scan, comma separated. Each is read against its own
# higher timeframe automatically.
SCANNER_TIMEFRAMES="H1,H4"

# How long to wait after a candle closes before analysing it. The exchange
# needs a moment to settle the final candle; asking at the instant of close
# reliably returns one that is still being written.
SCANNER_CLOSE_DELAY_MS="90000"

# Which account the scanner tracks setups against. Only needed if the database
# holds more than one — otherwise it uses the single account.
SCANNER_USER_EMAIL=""

