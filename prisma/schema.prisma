// SpotLens data model — see ARCHITECTURE.md for field-level docs.
// Phases 1-8 are all modelled up front so migrations stay additive; only the
// Phase 1 tables (Asset, TradingPair, Candle) are written to today.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app's own queries.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection for migrations: Prisma takes advisory locks
  // that a connection pooler in transaction mode cannot hold. Falls back to
  // DATABASE_URL when unset, which is correct for a plain local Postgres.
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum Timeframe {
  M1
  M5
  M15
  H1
  H4
  D1
  W1
}

enum AssetCategory {
  LAYER1
  LAYER2
  INFRASTRUCTURE
  ORACLE
  DEFI_INFRASTRUCTURE
  PAYMENTS
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum Trend {
  BULLISH
  BEARISH
  SIDEWAYS
}

enum SetupStatus {
  POTENTIAL_SETUP
  WAIT_FOR_CONFIRMATION
  HIGH_RISK
  AVOID
}

/// Lifecycle of a tracked setup, distinct from the analysis verdict.
///
/// `SetupStatus` above is what the engine says about the market right now.
/// This is what happened to one particular setup over time, which is a
/// different question and needs its own vocabulary. CONFIRMATION_DETECTED is a
/// lifecycle state, never an instruction — there is no CONFIRMED trading
/// status and no code path that could act on one.
enum SetupLifecycleStatus {
  SETUP_FORMING
  WAITING_CONFIRMATION
  CONFIRMATION_DETECTED
  POTENTIAL_SETUP
  INVALIDATED
}

/// What a notification is about.
///
/// A mapping of the lifecycle truth Phase D already records, not a second state
/// machine: each of these is derived from a `SetupEvent` that has already
/// happened, or from a scanner run that has already finished.
enum NotificationEventType {
  SETUP_DETECTED
  CONFIRMATION_DETECTED
  SETUP_INVALIDATED
  STRUCTURE_CHANGED
  DAILY_SUMMARY
  SYSTEM_ERROR
}

enum NotificationChannel {
  IN_APP
  TELEGRAM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScannerRunStatus {
  RUNNING
  COMPLETED
  /// Some markets failed and the rest were analysed. One asset failing must
  /// never make a whole scan worthless.
  PARTIAL
  FAILED
}

enum ScannerResultStatus {
  OK
  FAILED
}

/// Why one market's analysis failed, kept coarse on purpose.
///
/// Categories, never the raw error: a stack trace or a provider payload can
/// carry a URL, a token or a host, and none of that belongs in a table the UI
/// reads from.
enum ScannerFailureCategory {
  MARKET_DATA_ERROR
  INVALID_DATA
  ANALYSIS_ERROR
  DATABASE_ERROR
  UNKNOWN
}

enum SetupEventType {
  CREATED
  STATUS_CHANGED
  CONFIRMATION_DETECTED
  POTENTIAL_SETUP
  INVALIDATED
}

/// What the user decided about a setup.
///
/// These are decisions, not trade states: SpotLens never places an order, so
/// nothing here is produced by the system. Every transition is something a
/// person chose.
enum JournalDecision {
  /// Recorded but not acted on yet.
  WATCHING
  /// Deliberately passed over. Research data, not an absence of data.
  SKIPPED
  /// The user entered a position themselves, on their own exchange.
  TAKEN
  /// Was watching or taken, then abandoned before an outcome existed.
  CANCELLED
  /// A taken position the user has since closed and recorded the result of.
  CLOSED
}

/// Why a setup was passed over. Optional — never inferred, never required.
enum JournalSkipReason {
  LOW_CONFIDENCE
  POOR_RR
  BAD_REGIME
  NO_CONFIRMATION
  PERSONAL_RULE
  MARKET_CONDITION
  MISSED_ENTRY
  OTHER
}

/// How a manually taken position ended. Recorded by the user, never inferred.
enum TradeExitReason {
  TAKE_PROFIT
  STOP_LOSS
  MANUAL_EXIT
  INVALIDATED
  OTHER
}

enum JournalEventType {
  CREATED
  DECISION_CHANGED
  OUTCOME_RECORDED
  NOTE_ADDED
}

enum YesNoUnclear {
  YES
  NO
  UNCLEAR
}

enum BacktestStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum SetupOutcome {
  TP1_HIT
  TP2_HIT
  TP3_HIT
  SL_HIT
  NO_HIT
  STILL_OPEN
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  emailVerified      DateTime?
  passwordHash       String?
  name               String?
  image              String?
  role               Role      @default(USER)
  plan               Plan      @default(FREE)
  defaultRiskPercent Decimal   @default(1.0) @db.Decimal(5, 2)
  defaultTimeframe   Timeframe @default(H1)
  acceptedTermsAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  watchlist          Watchlist[]
  snapshots          AnalysisSnapshot[]
  backtestRuns       BacktestRun[]
  trackedSetups      TrackedSetup[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference?
  telegramConnection TelegramConnection?
  subscription       Subscription?
  auditLogs          AdminAuditLog[]
  checklistsUpdated  EthicalChecklist[]      @relation("ChecklistUpdatedBy")
  JournalEntry       JournalEntry[]
}

// --- NextAuth Prisma adapter tables (standard shape) -----------------------

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Curated market universe ------------------------------------------------

model Asset {
  id                 String        @id @default(uuid())
  symbol             String        @unique
  name               String
  category           AssetCategory
  officialWebsite    String
  description        String
  utilityExplanation String
  riskLevel          RiskLevel
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  pairs            TradingPair[]
  ethicalChecklist EthicalChecklist?
}

model TradingPair {
  id             String  @id @default(uuid())
  assetId        String
  quoteCurrency  String
  exchangeSymbol String  @unique
  isActive       Boolean @default(true)

  asset          Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  candles        Candle[]
  watchlist      Watchlist[]
  snapshots      AnalysisSnapshot[]
  backtestRuns   BacktestRun[]
  trackedSetups  TrackedSetup[]
  scannerResults ScannerResult[]

  @@unique([assetId, quoteCurrency])
}

model EthicalChecklist {
  id                           String       @id @default(uuid())
  assetId                      String       @unique
  whatProjectDoes              String
  tokenUtility                 String
  involvesInterestLending      YesNoUnclear
  involvesInterestLendingNote  String?
  supportsGambling             YesNoUnclear
  supportsGamblingNote         String?
  supportsProhibitedIndustries YesNoUnclear
  supportsProhibitedNote       String?
  hasClearUtility              YesNoUnclear
  hasClearUtilityNote          String?
  updatedAt                    DateTime     @updatedAt
  updatedByUserId              String?

  asset         Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  updatedByUser User? @relation("ChecklistUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

// --- Market data cache ------------------------------------------------------

model Candle {
  id            String    @id @default(uuid())
  tradingPairId String
  timeframe     Timeframe
  openTime      DateTime
  open          Decimal   @db.Decimal(24, 8)
  high          Decimal   @db.Decimal(24, 8)
  low           Decimal   @db.Decimal(24, 8)
  close         Decimal   @db.Decimal(24, 8)
  volume        Decimal   @db.Decimal(30, 8)
  closeTime     DateTime

  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: Cascade)

  @@unique([tradingPairId, timeframe, openTime])
  @@index([tradingPairId, timeframe, openTime])
}

// --- User-scoped data -------------------------------------------------------

model Watchlist {
  id            String   @id @default(uuid())
  userId        String
  tradingPairId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: Cascade)

  @@unique([userId, tradingPairId])
}

model AnalysisSnapshot {
  id                    String      @id @default(uuid())
  userId                String?
  tradingPairId         String
  timeframe             Timeframe
  trend                 Trend
  trendReason           String
  supportZones          Json
  resistanceZones       Json
  entryLow              Decimal     @db.Decimal(24, 8)
  entryHigh             Decimal     @db.Decimal(24, 8)
  entryReason           String
  confirmationChecklist Json
  stopLoss              Decimal     @db.Decimal(24, 8)
  stopLossReason        String
  takeProfits           Json
  riskRewardRatio       Decimal     @db.Decimal(10, 2)
  setupScore            Int
  setupScoreBreakdown   Json
  status                SetupStatus
  statusReason          String
  indicatorsSnapshot    Json
  mtfSummary            Json?
  disclaimerVersion     String
  createdAt             DateTime    @default(now())

  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BacktestRun {
  id             String         @id @default(uuid())
  userId         String
  tradingPairId  String
  timeframe      Timeframe
  startDate      DateTime
  endDate        DateTime
  status         BacktestStatus @default(QUEUED)
  numSetups      Int?
  winRate        Decimal?       @db.Decimal(5, 2)
  avgRealizedRR  Decimal?       @db.Decimal(10, 2)
  maxDrawdownPct Decimal?       @db.Decimal(6, 2)
  bestSetupId    String?
  worstSetupId   String?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingPair TradingPair     @relation(fields: [tradingPairId], references: [id], onDelete: Cascade)
  setups      BacktestSetup[]

  @@index([userId, createdAt])
}

model BacktestSetup {
  id            String       @id @default(uuid())
  backtestRunId String
  triggeredAt   DateTime
  entry         Decimal      @db.Decimal(24, 8)
  stopLoss      Decimal      @db.Decimal(24, 8)
  takeProfits   Json
  outcome       SetupOutcome
  realizedRR    Decimal?     @db.Decimal(10, 2)
  exitTime      DateTime?
  exitPrice     Decimal?     @db.Decimal(24, 8)

  backtestRun BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)

  @@index([backtestRunId, triggeredAt])
}

// --- Content & ops ----------------------------------------------------------

model LearnArticle {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  category           String
  bodyMarkdown       String
  relatedConceptTags String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String
  diff        Json
  createdAt   DateTime @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  stripeCustomerId     String
  stripeSubscriptionId String
  plan                 Plan
  status               String
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One setup, tracked across the runs that keep re-evaluating it.
///
/// Named `TrackedSetup` rather than `Setup` because the codebase already has
/// two other things called a setup: the `TradeSetup` the engine returns for the
/// current bar, and `BacktestSetup`, a simulated trade. This is neither — it is
/// the identity of a level being watched over time.
///
/// ## Two halves, and the split is the point
///
/// Everything from `entryLow` down to `snapshot` is written once, at creation,
/// and never updated. It is what the engine said when this setup was first
/// seen. Later analysis will move the entry and change the score — that is the
/// market, not a correction — and silently rewriting these would destroy the
/// only record of what was actually on offer at the time.
///
/// The lifecycle fields below them do change, because they are the answer to
/// "what happened next". Every change also appends a `SetupEvent`, so the
/// sequence survives even though the current state is overwritten.
model TrackedSetup {
  id            String               @id @default(uuid())
  userId        String
  tradingPairId String
  timeframe     Timeframe
  status        SetupLifecycleStatus

  // --- immutable snapshot: written at creation, never updated ---------------
  entryLow              Decimal     @db.Decimal(24, 8)
  entryHigh             Decimal     @db.Decimal(24, 8)
  stopLoss              Decimal     @db.Decimal(24, 8)
  takeProfit1           Decimal?    @db.Decimal(24, 8)
  takeProfit2           Decimal?    @db.Decimal(24, 8)
  takeProfit3           Decimal?    @db.Decimal(24, 8)
  riskReward            Decimal     @db.Decimal(10, 2)
  /// Phase A's distinction, carried through: a ratio measured to an R-multiple
  /// is not evidence, and a stored setup must not lose that qualifier.
  riskRewardIsSynthetic Boolean
  score                 Int
  scoreGrade            String
  /// The engine's verdict at creation, for comparison against the lifecycle.
  analysisStatus        SetupStatus
  /// Reasons, score breakdown and targets as they stood — the full text, so
  /// the record explains itself without re-running anything.
  snapshot              Json

  // --- identity ------------------------------------------------------------
  /// The support zone the entry was anchored to. Identity is decided by
  /// overlap against this, not by equality: zones are ATR-scaled and drift a
  /// little every candle, and keying on exact bounds would mint a new setup
  /// on every run.
  originZoneLow  Decimal @db.Decimal(24, 8)
  originZoneHigh Decimal @db.Decimal(24, 8)

  // --- lifecycle: mutable, and mirrored into SetupEvent --------------------
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  confirmedAt        DateTime?
  invalidatedAt      DateTime?
  invalidationReason String?

  /// Reference rather than a second copy of the same analysis.
  analysisSnapshotId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingPair  TradingPair   @relation(fields: [tradingPairId], references: [id], onDelete: Cascade)
  events       SetupEvent[]
  journalEntry JournalEntry?

  @@index([userId, tradingPairId, timeframe, status])
  @@index([userId, createdAt])
}

/// An append-only record of every lifecycle change.
///
/// Written only when the status actually moves. Re-evaluating a setup that has
/// not changed writes nothing at all — which is what keeps a scanner running
/// every few minutes from turning into a table of identical rows.
model SetupEvent {
  id         String                @id @default(uuid())
  setupId    String
  type       SetupEventType
  fromStatus SetupLifecycleStatus?
  toStatus   SetupLifecycleStatus
  detail     String
  /// Confirmation signals and explanation at the moment of the transition.
  payload    Json?
  createdAt  DateTime              @default(now())

  setup TrackedSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@index([setupId, createdAt])
}

/// One pass of the scanner over the market universe.
///
/// Counts are kept on the run itself so "what did the scanner conclude?" is a
/// single read, and so the no-trade outcomes survive: a scan where 43 of 45
/// markets said AVOID is the tool working, and a summary that only counted
/// setups would hide it.
model ScannerRun {
  id          String           @id @default(uuid())
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  status      ScannerRunStatus @default(RUNNING)
  /// Which timeframes this pass covered, in the order they were scanned.
  timeframes  Timeframe[]
  /// Whether a person asked for this scan or the schedule did.
  triggeredBy String           @default("SCHEDULE")

  marketCount Int @default(0)
  analysed    Int @default(0)
  succeeded   Int @default(0)
  failed      Int @default(0)

  // --- what the markets actually said, no-trade outcomes included ----------
  potentialSetups Int @default(0)
  waiting         Int @default(0)
  highRisk        Int @default(0)
  avoided         Int @default(0)

  // --- what changed as a result -------------------------------------------
  setupsCreated Int @default(0)
  stateChanges  Int @default(0)
  invalidations Int @default(0)

  durationMs Int?

  results ScannerResult[]

  @@index([startedAt])
}

/// One market on one timeframe, as the scanner found it.
///
/// Stored for every market rather than only the interesting ones, because
/// "nothing here" is the answer most of the time and a scanner that only
/// recorded its hits would be impossible to audit. Roughly 90 rows per pass.
model ScannerResult {
  id            String              @id @default(uuid())
  scannerRunId  String
  tradingPairId String
  timeframe     Timeframe
  status        ScannerResultStatus

  /// The engine's verdict. Null when the market failed before it ran.
  analysisStatus        SetupStatus?
  score                 Int?
  riskReward            Decimal?     @db.Decimal(10, 2)
  /// Carried through so ranking can refuse to credit an unmeasured reward.
  riskRewardIsSynthetic Boolean?
  /// Open time of the last CLOSED candle the analysis was run on, epoch ms.
  analysedAtCandle      BigInt?

  trackedSetupId  String?
  lifecycleStatus SetupLifecycleStatus?

  // --- context for the shortlist's explanation, as it stood on this pass ----
  /// Read off the analysis this pass produced rather than a stored setup's
  /// snapshot: a snapshot is frozen at creation, and presenting a days-old
  /// trend as current is the mistake the notification layer already made once.
  /// Null on rows written before these columns existed.
  trend           String?
  mtfAgreement    String?
  regimeDirection String?

  failureCategory ScannerFailureCategory?
  /// A short, sanitised message. Never a stack trace.
  failureMessage  String?
  attempts        Int                     @default(1)

  durationMs Int?
  createdAt  DateTime @default(now())

  scannerRun  ScannerRun  @relation(fields: [scannerRunId], references: [id], onDelete: Cascade)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: Cascade)

  @@index([scannerRunId, timeframe])
  @@index([tradingPairId, createdAt])
}

/// One notification, on one channel.
///
/// A row per channel rather than per event, because in-app and Telegram
/// succeed and fail independently: Telegram being unreachable must leave the
/// in-app copy delivered, and retrying one must not resend the other.
model Notification {
  id       String                @id @default(uuid())
  userId   String
  type     NotificationEventType
  channel  NotificationChannel
  priority NotificationPriority
  status   NotificationStatus    @default(PENDING)

  /// Rendered at creation from structured data, so the record shows exactly
  /// what the reader saw even if the setup later changes.
  title String
  body  String

  // --- what it is about, for filtering and for the UI ----------------------
  trackedSetupId String?
  asset          String?
  timeframe      Timeframe?

  /// Deterministic identity, derived from the lifecycle event that caused it.
  /// The unique index below is what makes the whole layer idempotent: a
  /// scanner pass that re-observes an unchanged setup cannot insert a second
  /// copy, whatever the caller does.
  dedupeKey String

  readAt   DateTime?
  sentAt   DateTime?
  attempts Int       @default(0)
  /// A sanitised category and message. Never a token, never a stack trace.
  error    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([userId, status])
}

/// Which notifications a user wants, and where.
///
/// Defaults are deliberately quiet. A first scan over 45 markets created 20
/// setups at forming or waiting; a channel that announced all of them would
/// teach its reader to ignore it within a day.
model NotificationPreference {
  userId String @id

  inAppEnabled    Boolean @default(true)
  telegramEnabled Boolean @default(false)

  setupDetected        Boolean @default(true)
  confirmationDetected Boolean @default(true)
  setupInvalidated     Boolean @default(true)
  structureChanged     Boolean @default(false)
  dailySummary         Boolean @default(false)
  systemError          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A user's Telegram binding, and the pending code that creates one.
///
/// The bot token is never here. It lives only in the server's environment: a
/// token in a database is a token in every backup of it.
model TelegramConnection {
  userId String @id

  /// Null until the connection is completed.
  chatId      String?
  chatLabel   String?
  connectedAt DateTime?

  /// SHA-256 of the one-time code. Storing the code itself would mean anyone
  /// with read access to this table could bind their own chat to the account.
  pendingCodeHash String?
  pendingExpires  DateTime?
  /// Attempts to claim the current code, so guessing is bounded.
  claimAttempts   Int       @default(0)

  /// Telegram's update cursor, so one poll cannot re-read old messages.
  lastUpdateId BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One human decision about one setup.
///
/// The journal answers a different question from everything else in the
/// schema. `TrackedSetup` records what the engine said; this records what the
/// person did about it, and the two are deliberately kept apart so neither can
/// be mistaken for the other.
///
/// It carries no copy of the engine's numbers. The setup's snapshot is already
/// immutable — written once at creation and never rewritten — so duplicating
/// it here would create a second version of the same truth that could drift
/// from the first. The only engine fact frozen here is the lifecycle state at
/// the moment of the decision, because that one *does* keep changing.
///
/// One entry per setup per user, enforced by the unique index: journaling the
/// same setup twice is a mistake, not a second opinion.
model JournalEntry {
  id             String @id @default(uuid())
  userId         String
  trackedSetupId String

  decision JournalDecision @default(WATCHING)

  /// Where the setup was in its lifecycle when this decision was made. Frozen,
  /// because the setup will move on and the decision was made against this.
  setupStatusAtDecision SetupLifecycleStatus
  /// The moment the decision was made — and the cutoff a replay reconstructs to.
  decidedAt             DateTime             @default(now())

  skipReason JournalSkipReason?
  notes      String?

  // --- the actual trade, when one was taken -------------------------------
  //
  // Deliberately separate from the setup's own entry/stop/target: the user's
  // fill is rarely the plan, and overwriting the plan with the fill would
  // destroy the only record of the difference between them.
  actualEntry      Decimal?         @db.Decimal(24, 8)
  actualStopLoss   Decimal?         @db.Decimal(24, 8)
  actualTakeProfit Decimal?         @db.Decimal(24, 8)
  actualExit       Decimal?         @db.Decimal(24, 8)
  quantity         Decimal?         @db.Decimal(30, 8)
  fees             Decimal?         @db.Decimal(24, 8)
  slippage         Decimal?         @db.Decimal(24, 8)
  exitReason       TradeExitReason?
  openedAt         DateTime?
  closedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedSetup TrackedSetup   @relation(fields: [trackedSetupId], references: [id], onDelete: Cascade)
  events       JournalEvent[]

  @@unique([trackedSetupId])
  @@index([userId, decidedAt])
  @@index([userId, decision])
}

/// An append-only record of how a decision changed.
///
/// "What did I decide?" is rarely one answer — a setup gets watched, then
/// taken, then closed — and the sequence is the interesting part. Overwriting
/// `decision` alone would keep only the last frame of it.
model JournalEvent {
  id             String           @id @default(uuid())
  journalEntryId String
  type           JournalEventType
  fromDecision   JournalDecision?
  toDecision     JournalDecision
  detail         String
  /// The values this event replaced, when it replaced any.
  ///
  /// `JournalEntry` holds the latest numbers, which is what every reader
  /// wants. Recording an outcome over one already there would otherwise
  /// destroy the previous version — so the superseded fields are written here
  /// first, in full and structured, and the entry is then updated. Null on a
  /// first recording, because nothing was superseded, and null on every event
  /// written before this column existed.
  ///
  /// Shape when present: `{ supersededOutcome: { ...the ten trade fields,
  /// realizedR, supersededAt } }`. See `lib/journal/amendment.ts`.
  payload        Json?
  createdAt      DateTime         @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId, createdAt])
}
